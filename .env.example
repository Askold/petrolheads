# Domain pointing at your VPS (A record). Caddy issues the HTTPS certificate automatically.
DOMAIN=petrolheads.example.com
PUBLIC_URL=https://petrolheads.example.com

# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
# Random string; Telegram sends it back on every webhook call. Generate with: openssl rand -hex 24
BOT_WEBHOOK_SECRET=change-me

# Chat id of your car group (starts with -100...). Leave empty to let anyone in.
GROUP_CHAT_ID=
# Comma-separated Telegram user ids who can verify laps and add tracks
ADMIN_TELEGRAM_IDS=

DATABASE_PASSWORD=change-me-too

# Local development only: accepts "Authorization: tma dev" as a fake user. Never true in production.
DEV_AUTH=false

# Host port for Postgres (loopback only). Change if 5432 is taken locally.
DB_PORT=5432
